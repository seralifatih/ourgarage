---
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { getGuides, guideUrl } from '../lib/guides';
import { SITE_URL, APP_STORE_ID, appStoreUrl } from '../site';

const guides = (await getGuides()).slice(0, 6);
const store = appStoreUrl('seo-home');

// Desktop visitors can't install from their computer, so the hero offers a QR
// code to scan with their iPhone. Generated at build time as inline SVG (no
// request, no third-party service), with its own campaign token so scans show
// up separately from badge taps in App Analytics.
const qrUrl = appStoreUrl('seo-home-qr');
const qrSvg = await QRCode.toString(qrUrl, {
    type: 'svg',
    errorCorrectionLevel: 'M',
    margin: 2, // quiet zone; the card's padding adds more
    color: { dark: '#16201f', light: '#ffffff' },
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'OurGarage: Car Maintenance',
    operatingSystem: 'iOS',
    applicationCategory: 'UtilitiesApplication',
    url: SITE_URL,
    installUrl: `https://apps.apple.com/us/app/id${APP_STORE_ID}`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'OurGarage',
    url: `${SITE_URL}/`,
  },
];
---
<Base
  title="OurGarage: Car Maintenance Reminders for Your Household"
  description="Oil change and service reminders by date or mileage, a service history that stays on your phone, with household sharing on the way."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero wrap wide">
    <div class="hero-grid">
      <div>
        <h1>Know what your car needs before it becomes a problem</h1>
        <p class="lede">OurGarage reminds you about oil changes, tire rotations and every other service by date, by mileage, or both. Every service you log builds a history you can keep, export or hand to the next owner.</p>
        <a class="badge-link" href={store} rel="noopener">
          <img src="/app-store-badge.svg" alt="Download on the App Store" width="162" height="54">
        </a>
      </div>
      {/* Also a link: clickable on desktop, and a fallback for anyone who
          can't scan. The image is decorative to screen readers; the caption
          says what it is. */}
      <a class="qr-card" href={qrUrl} rel="noopener">
        <span class="qr" aria-hidden="true" set:html={qrSvg} />
        <span class="qr-caption">On your computer? Scan with your iPhone camera to get the app.</span>
      </a>
    </div>
  </section>

  <section class="wrap wide">
    <div class="features">
      <div class="feature">
        <h2>Reminders by date or mileage</h2>
        <p>Every 6 months, every 5,000 miles, or whichever comes first. You get a notification the morning it falls due.</p>
      </div>
      <div class="feature">
        <h2>Service history in seconds</h2>
        <p>What was done, when, at what mileage, and what it cost. It works with no signal, so you can log it standing in the shop.</p>
      </div>
      <div class="feature">
        <h2>Household sharing, coming soon</h2>
        <p>We're building one shared garage for everyone who drives the car, so when one person logs an oil change, everyone sees it. It arrives in an upcoming update.</p>
      </div>
      <div class="feature">
        <h2>Free for one car</h2>
        <p>No ads and no trial timer. Premium adds more vehicles, cost totals and export.</p>
      </div>
    </div>

    <div class="shots" aria-label="App screenshots">
      <img src="/shots/01_garage.webp" width="440" height="957" alt="OurGarage garage screen listing the household's cars" loading="lazy">
      <img src="/shots/02_reminders.webp" width="440" height="957" alt="Reminders screen showing an oil change due in 320 miles and a tire rotation every 6 months or 7,500 miles" loading="lazy">
      <img src="/shots/03_history.webp" width="440" height="957" alt="Service history screen with past services and costs" loading="lazy">
    </div>
  </section>

  {guides.length > 0 && (
    <section class="wrap wide">
      <h2>Car maintenance guides</h2>
      <p class="muted">Plain answers to how often, what to check and how to keep track. <a href="/guides/">All guides</a></p>
      <ul class="guide-list">
        {guides.map((g) => (
          <li>
            <a class="guide-card" href={guideUrl(g.id)}>
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
